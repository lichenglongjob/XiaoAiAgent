# LLM 配置
llm:
  provider: "deepseek"
  api_key: "${DEEPSEEK_API_KEY}"
  model: "deepseek-chat"
  base_url: "https://api.deepseek.com"
  temperature: 0.7
  extra: {}

# 小米账号/音箱配置
xiaomi:
  username: "${MI_USER}"
  password: "${MI_PASS}"
  did: ""                        # 设备ID，运行 `python main.py --list-devices` 获取
  hardware: "L05C"
  use_command: true
  mute_xiaoai: false
  trigger_word: ""
  tts_command: [5, 3]
  wake_command: [5, 4]
  polling_interval: 1.0
  debug: false

# FastAPI 服务配置
server:
  host: "0.0.0.0"
  port: 8000

# MCP 服务配置（远程 SSE，按需添加）
mcp_servers:
  # - name: "filesystem"
  #   url: "http://localhost:3001/sse"
